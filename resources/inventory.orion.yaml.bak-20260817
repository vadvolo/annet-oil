# Named credential groups. A device's `role` selects a group, which is tried
# first at login and falls back to `default` if rejected. Role groups stay
# inert until their env vars are set: an empty login is skipped, so unset groups
# simply fall back to `default` without wasting a login attempt.
credentials:
  default:
    login: "${DEVICE_USERNAME}"
    password: "${DEVICE_PASSWORD}"
  infra-router:
    login: "${INFRA_ROUTER_USERNAME}"
    password: "${INFRA_ROUTER_PASSWORD}"
  client-router:
    login: "${CLIENT_ROUTER_USERNAME}"
    password: "${CLIENT_ROUTER_PASSWORD}"
