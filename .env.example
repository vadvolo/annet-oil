# Annet Oil Authentication Token
# This token is used for authentication between MCP and Annet Oil API
# Please change this to a secure value in production
ANNET_OIL_AUTH_TOKEN=change-me-in-production

# API URL for MCP to connect to host-based Annet Oil API
# Default uses host.docker.internal for Docker Desktop
# On Linux, this might need to be the host's actual IP
ANNET_OIL_API_URL=http://host.docker.internal:8080

# Annet Oil API configuration (for host service)
ANNET_OIL_HOST=0.0.0.0
ANNET_OIL_PORT=8080

# Optional: Override default SSH port for Annet Oil
# ANNET_OIL_SSH_PORT=2222